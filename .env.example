# Configuración del Nodo Nueva Troya

# Supabase (Copiar del panel de Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=only-if-needed

# Seguridad del Orquestador (Usa una clave fuerte y única para el ESP32)
ORCHESTRATOR_SECRET=tu_clave_secreta_aqui

# Puerto Local
PORT=3000
